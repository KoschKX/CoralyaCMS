{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/editor/[id]",
      "regex": "^/admin/editor/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/editor/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/pages/[id]",
      "regex": "^/api/pages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/pages/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[slug]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/editor/new",
      "regex": "^/admin/editor/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/editor/new(?:/)?$"
    },
    {
      "page": "/admin/settings/blocks",
      "regex": "^/admin/settings/blocks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/blocks(?:/)?$"
    },
    {
      "page": "/admin/settings/navigation",
      "regex": "^/admin/settings/navigation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/navigation(?:/)?$"
    },
    {
      "page": "/admin/settings/plugins",
      "regex": "^/admin/settings/plugins(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/plugins(?:/)?$"
    },
    {
      "page": "/admin/settings/site",
      "regex": "^/admin/settings/site(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/site(?:/)?$"
    },
    {
      "page": "/admin/settings/theme",
      "regex": "^/admin/settings/theme(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/theme(?:/)?$"
    },
    {
      "page": "/admin/settings/users",
      "regex": "^/admin/settings/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings/users(?:/)?$"
    },
    {
      "page": "/api/pages",
      "regex": "^/api/pages(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/pages(?:/)?$"
    },
    {
      "page": "/api/settings",
      "regex": "^/api/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/settings(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}